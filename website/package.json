{
    "name": "wireman-website",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "imports": {
        "#lib": "./src/lib",
        "#lib/*": "./src/lib/*"
    },
    "engines": {
        "node": "^20.19 || ^22.12 || >=24"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check ."
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^4.0.1",
        "@sveltejs/kit": "^3.4.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/node": "^26.6.6",
        "prettier": "^3.3.2",
        "prettier-plugin-svelte": "^3.2.6",
        "svelte": "^5.56.6",
        "svelte-check": "^4.0.0",
        "typescript": "^6.0.0",
        "vite": "^8.3.5"
    }
}
